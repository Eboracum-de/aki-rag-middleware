[Unit]
Description=AKI RAG Middleware per-user mail sync worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RAG_USER@
Group=@RAG_GROUP@
WorkingDirectory=@RAG_DIR@
ExecCondition=/bin/bash -c '! grep -Eiq "^RAG_MAINTENANCE_MODE=(1|true|yes|on)$" "@RAG_DIR@/runtime.env"'
ExecStart=@RAG_DIR@/.venv/bin/python -m rag.mail_worker --config @RAG_DIR@/config.yaml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
